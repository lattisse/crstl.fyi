---
import Layout from "../layouts/Layout.astro";
import Github from "../assets/icons/github.svg";
import Email from "../assets/icons/envelope-at-fill.svg";
import Discord from "../assets/icons/discord.svg";
import Rocket from "../components/Rocket.astro";
import PostList from "../components/PostList.astro";
import { SITE } from "../lib/site";
import { getSortedPosts } from "../lib/posts";
import {
    jsonLdGraph,
    personSchema,
    websiteSchema,
} from "../lib/structured-data";

const posts = (await getSortedPosts()).slice(0, 2);
---

<Layout jsonLd={jsonLdGraph(websiteSchema(), personSchema())}>
    <h1>crstl</h1>
    <p>
        Hi! I'm Crystal. I do a bit of programming, some homelabbing, and play a
        lot of games. Right now, I'm learning C++, drawing, and 3D modeling. I
        like physics, rockets, and space.
    </p>
    <h2 class="section-title">recent posts</h2>
    <PostList posts={posts} />
    <p class="all-posts"><a href="/blog/">all posts →</a></p>
    <h2 class="section-title">links</h2>
    <ul class="links">
        <li>
            <Discord />
            <a
                href={SITE.discord}
                target="_blank"
                rel="noopener noreferrer"
            >
                @lattisse
            </a>
        </li>
        <li>
            <Github />
            <a href={SITE.github} target="_blank" rel="noopener noreferrer">
                lattisse
            </a>
        </li>
        <li>
            <Email />
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
    </ul>
    <Rocket />
</Layout>

<style>
    .section-title {
        font-size: 1.5em;
    }

    .all-posts {
        margin-top: -1rem;
        font-size: 0.9em;
    }

    .links {
        padding: 0;
    }

    .links li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        list-style: none;
        margin: 0 0 0.5rem;
    }
</style>
